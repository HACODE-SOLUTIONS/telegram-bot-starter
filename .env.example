# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# OPTIONAL: Public HTTPS URL for webhook mode (production)
# Leave empty for polling mode (development)
WEBHOOK_URL=

# OPTIONAL: Server port (default: 3000)
PORT=3000

# OPTIONAL: Environment (development/production)
NODE_ENV=development

# OPTIONAL: Log level (error/warn/info/debug)
LOG_LEVEL=info
